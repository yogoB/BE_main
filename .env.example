POSTGRES_DB=yogobi
POSTGRES_USER=yogobi
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AI_SERVER_URL=http://localhost:8000
# 운영 도구 scripts/catalog_csv.py가 발행한 CSV 저장소. 빈 값이면 기존 내장 시드 사용.
CATALOG_CSV_DIR=
# 카탈로그 원천 데이터셋(합본 CSV) 경로. 설정하면 시작 시 이 파일이 적재되고 개별 시드 적재는 건너뛴다(D-24).
YOGOBI_CATALOG_COMBINED_CSV=
# 카탈로그 원본을 고칠 수 있는 회원 ID(쉼표 구분). 비면 아무도 못 쓴다 — /api/v1/admin/catalog 는 운영자 전용이다.
CATALOG_ADMIN_USER_IDS=
# 백오피스 관리자(D-32). 둘 다 채워야 /admin.html 이 열린다. 비우면 관리자 계정을 만들지 않는다.
# 이 값이 원본이며 시작할 때 DB 계정에 반영된다 — 바꾸면 기존 관리자 로그인은 모두 끊긴다.
# 운영에서는 반드시 긴 임의 문자열로 바꾼다. 데모용 짧은 비밀번호를 그대로 쓰지 않는다.
ADMIN_ID=
ADMIN_PASSWORD=
# AI 서버와 동일한 서버 전용 토큰. 프론트에 전달하지 않는다.
AI_INTERNAL_TOKEN=
JWT_SECRET=
# JWT_SECRET: openssl rand -base64 32 로 생성. 다른 서버 키와 공유하지 않는다.
AUTH_SECURE_COOKIES=true
AUTH_SESSION_COOKIE_NAME=__Host-YGB_SESSION
AUTH_RETURN_URL=http://localhost:5173/
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# HTTP 로컬 개발만 AUTH_SECURE_COOKIES=false, AUTH_SESSION_COOKIE_NAME=YGB_SESSION.
# 운영은 정확한 프론트 HTTPS 오리진을 설정한다. 같은 사이트의 BE 또는 프록시를 사용한다.
YOGOBI_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://yogob.fly.dev

# 메일 발송은 쓰지 않는다(D-21). 가입은 메일 없이 바로 하고(D-20) 비밀번호 재설정 화면도 없다.
# 아래를 채우면 메일 토큰 가입·재설정이 다시 켜지고, 그때부터 미확인 계정은 로그인할 수 없다.
# AUTH_EMAIL_ENABLED=true 로 켜려면 SMTP_PASSWORD 까지 모두 설정해야 한다 — 하나라도 비면 가입이 막힌다.
AUTH_EMAIL_ENABLED=false
