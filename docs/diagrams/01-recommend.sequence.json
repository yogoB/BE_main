{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "요고비 · 추천과 직접 계산",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      560
    ]
  },
  "participants": [
    {
      "id": "visitor",
      "type": "frontend",
      "label": "사용자 화면",
      "sublabel": "비회원도 이용"
    },
    {
      "id": "endpoint",
      "type": "backend",
      "label": "추천·계산 API",
      "sublabel": "각 Controller"
    },
    {
      "id": "recommend",
      "type": "backend",
      "label": "RecommendationService",
      "sublabel": "공통 처리"
    },
    {
      "id": "catalog",
      "type": "database",
      "label": "DB 읽기 계층",
      "sublabel": "검수 CSV 기반 카탈로그"
    },
    {
      "id": "pricing",
      "type": "backend",
      "label": "CostCalculator",
      "sublabel": "순수 Java · pricing"
    }
  ],
  "messages": [
    {
      "id": "submit",
      "from": "visitor",
      "to": "endpoint",
      "y": 170,
      "label": "추천 또는 계산 요청",
      "note": "POST /api/v1/recommendations 또는 POST /api/v1/calculator. 비회원 이용 가능",
      "variant": "emphasis"
    },
    {
      "id": "dispatch",
      "from": "endpoint",
      "to": "recommend",
      "y": 210,
      "label": "recommend / calculate"
    },
    {
      "id": "load",
      "from": "recommend",
      "to": "catalog",
      "y": 250,
      "label": "요금제·티어·혜택·번들 조회",
      "note": "신규 추천은 active 상품만 조회. 없는 서비스는 제외·결손 기록, 후보 0건은 빈 결과와 missingInputs를 반환한다."
    },
    {
      "id": "inputs",
      "from": "catalog",
      "to": "recommend",
      "y": 290,
      "label": "계산할 조합 반환",
      "variant": "return"
    },
    {
      "id": "compute",
      "from": "recommend",
      "to": "pricing",
      "y": 330,
      "label": "조합별 calculate 호출",
      "note": "추천은 후보마다 반복, 계산기는 지정 조합 1회. 미사용 혜택은 0원. 번들은 first-fit이며 전역 최적 조합 탐색은 미구현",
      "variant": "emphasis"
    },
    {
      "id": "breakdown",
      "from": "pricing",
      "to": "recommend",
      "y": 370,
      "label": "총액·절감액·항목별 출처",
      "variant": "return"
    },
    {
      "id": "result",
      "from": "recommend",
      "to": "endpoint",
      "y": 410,
      "label": "추천 상위 5개 / 계산 1개",
      "note": "monthlyTotal 오름차순 추천. accuracy와 missingInputs를 함께 반환",
      "variant": "return"
    },
    {
      "id": "render",
      "from": "endpoint",
      "to": "visitor",
      "y": 450,
      "label": "결과와 부족한 조건 표시",
      "note": "자료 결손은 200 PARTIAL과 안내. 잘못된 입력은 400. CSV 미검수 AI 가격은 계산하지 않는다.",
      "variant": "return"
    }
  ]
}
